{
  "name": "restaurant-ordering-backend",
  "version": "1.0.0",
  "description": "Basic restaurant ordering system with Express and PostgreSQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup": "npm install && npm run db:init && npm run db:seed",
    "db:init": "node src/scripts/init-db.js",
    "db:seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "pg": "^8.13.1",
    "restaurant-ordering-backend": "file:",
    "stripe": "^14.25.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
